APP_NAME=DataMind Agent
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api/v1
API_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=5173

# Offline development mode
STORAGE_BACKEND=json
QUERY_EXECUTOR=mock
DATA_DIR=data
# Local CSV directory. Keep the real machine path in backend/.env only.
EXTERNAL_DATA_DIR=

# Database settings. Keep offline mode until the OpenGauss Python driver is verified.
DATABASE_SCHEMA=fwwb
BUSINESS_SCHEMAS=["manufacturing"]
DATABASE_READONLY_URL=
DATABASE_URL=postgresql+asyncpg://datamind:change-me@postgres:5432/datamind

# SQL safety
SQL_MAX_ROWS=1000
SQL_TIMEOUT_SECONDS=30

# Legacy PostgreSQL Docker variables; remove after Docker is migrated to OpenGauss.
POSTGRES_DB=datamind
POSTGRES_USER=datamind
POSTGRES_PASSWORD=change-me

# Optional infrastructure
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=datamind
MINIO_SECRET_KEY=change-me-minio

# DeepSeek remains disabled until integration testing.
LLM_ENABLED=false
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Frontend development settings (copy to frontend/.env.local when needed)
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_ENABLE_MOCK_FALLBACK=true
