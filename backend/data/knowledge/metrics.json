[
  {
    "id": 1,
    "metric_code": "output_qty",
    "metric_name": "产量",
    "category": "生产",
    "description": "指定统计范围内的实际生产数量。",
    "formula_expression": "SUM(good_qty + defect_qty)",
    "unit": "件",
    "time_field": "stat_date",
    "source_tables": [
      "manufacturing.mes_process_output"
    ],
    "dimension_fields": [
      "line_id",
      "process_id"
    ],
    "synonyms": [
      "生产数量",
      "实际产量"
    ],
    "status": "active",
    "version": 1,
    "created_at": "2026-07-26T00:00:00+08:00",
    "updated_at": "2026-07-26T00:00:00+08:00"
  },
  {
    "id": 2,
    "metric_code": "process_yield_rate",
    "metric_name": "工序良品率",
    "category": "质量",
    "description": "合格数量占实际生产数量的比例。",
    "formula_expression": "SUM(good_qty) / NULLIF(SUM(input_qty), 0)",
    "unit": "%",
    "time_field": "stat_date",
    "source_tables": [
      "manufacturing.mes_process_output"
    ],
    "dimension_fields": [
      "line_id",
      "process_id"
    ],
    "synonyms": [
      "良率",
      "合格率"
    ],
    "status": "active",
    "version": 1,
    "created_at": "2026-07-26T00:00:00+08:00",
    "updated_at": "2026-07-26T00:00:00+08:00"
  },
  {
    "id": 3,
    "metric_code": "defect_rate",
    "metric_name": "不良率",
    "category": "质量",
    "description": "不良数量占检验数量的比例。",
    "formula_expression": "SUM(defect_qty) / NULLIF(SUM(sample_qty), 0)",
    "unit": "%",
    "time_field": "inspection_date",
    "source_tables": [
      "manufacturing.qms_inspection"
    ],
    "dimension_fields": [
      "product_id",
      "process_id"
    ],
    "synonyms": [
      "缺陷率",
      "次品率"
    ],
    "status": "active",
    "version": 1,
