  {
    "task_id": "419eaae8-f72d-4810-8213-bb30d61aa9aa",
    "conversation_id": "5c888777-277f-4bea-b13b-63d740bd734d",
    "question": "分析最近30天各产线的不良率",
    "intent": "defect_rate_analysis",
    "plan": {
      "intent": "manufacturing_data_analysis",
      "metric_codes": [
        "defect_rate"
      ],
      "tables": [
        "manufacturing.fact_quality_inspection",
        "manufacturing.dim_production_line"
      ],
      "steps": [
        "识别意图",
        "匹配业务指标",
        "定位数据表",
        "生成安全查询",
        "展示分析结果"
      ]
    },
    "sql": "SELECT line.line_name AS category, ROUND(SUM(q.defect_qty) * 100.0 / NULLIF(SUM(q.inspected_qty), 0), 2) AS value FROM manufacturing.fact_quality_inspection AS q JOIN manufacturing.dim_production_line AS line ON line.id = q.line_id WHERE q.inspection_date >= CURRENT_DATE - INTERVAL '30 DAYS' GROUP BY line.line_name ORDER BY value DESC LIMIT 1000",
    "columns": [
      "category",
      "value"
    ],
    "rows": [
